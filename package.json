{
  "name": "@onamea/app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt app.tsx vite.config.ts components lib assets",
    "format:check": "oxfmt --check app.tsx vite.config.ts components lib assets",
    "lint": "oxlint .",
    "compile": "tsc --noEmit",
    "typecheck": "pnpm compile",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm compile",
    "cf:dev": "pnpm build --mode development && wrangler dev",
    "cf:deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@onamea/crdt": "0.6.7",
    "@onamea/types": "0.5.4",
    "@preact/signals": "^2.11.3",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  }
}
