{
  "name": "@onamea/app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt app.tsx vite.config.ts components lib assets",
    "format:check": "oxfmt --check app.tsx vite.config.ts components lib assets",
    "lint": "oxlint .",
    "compile": "tsc --noEmit",
    "typecheck": "pnpm compile",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm compile",
    "cf:dev": "pnpm build --mode development && wrangler dev",
    "cf:deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@onamea/crdt": "npm:@jsr/onamea__crdt@0.6.2",
    "@onamea/types": "npm:@jsr/onamea__types@^0.5.3",
    "@preact/signals": "^2.11.3",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.1",
    "wrangler": "^4.155.0"
  }
}
